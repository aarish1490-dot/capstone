# AarishMart environment configuration
# Copy this file to `.env` (which is git-ignored) and fill in your values.
# Real environment variables always take precedence over this file.
#
# OTP delivery mode
#   development (default) - mock SMS provider: OTP printed to log + login page
#   production            - real SMS only; fails fast at startup if unconfigured
OTP_MODE=development

# development mode can still use a real provider:
SMS_PROVIDER=mock

# Real SMS gateway (only used when SMS_PROVIDER=real)
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# Customize the HTTP JSON body. Placeholders:
#   {to} {message} {senderId} {apiKey} {apiSecret}   (JSON-escaped)
SMS_PAYLOAD_TEMPLATE={"to":"{to}","message":"{message}","senderId":"{senderId}"}

# Auth header customization
SMS_AUTH_HEADER=Authorization
SMS_AUTH_VALUE_TEMPLATE=Bearer {apiKey}

# OTP rules
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# AI shopping assistant
#   mock (default)  - deterministic local replies, no external calls (dev)
#   gemini          - Google Gemini; needs GEMINI_API_KEY.
#                     If the key is missing the app falls back to mock.
AI_PROVIDER=mock

# Google Gemini API key (never commit a real key; copy to .env which is git-ignored)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=20

# Database (defaults shown)
# DHAT_DB_URL=jdbc:h2:file:~/aarishmart;AUTO_SERVER=TRUE
# DHAT_DB_USER=sa
# DHAT_DB_PASSWORD=
#
# On Render an attached disk is automatically available at $RENDER_DISK_PATH and
# the container entrypoint uses it (jdbc:h2:file:$RENDER_DISK_PATH/aarishmart)
# unless DHAT_DB_URL is set explicitly.
