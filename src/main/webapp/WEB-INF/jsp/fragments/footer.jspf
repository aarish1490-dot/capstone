    </div>
</main>
<footer class="footer">
    <div class="container">
        DhatchinaMart &copy; 2026 &middot; A multi-seller e-commerce marketplace &middot; MVP build
    </div>
</footer>

<div class="chat-widget" id="chatWidget" aria-hidden="false">
    <button type="button" class="chat-launcher" id="chatLauncher"
            aria-label="Open the DhatchinaMart shopping assistant" aria-controls="chatPanel">
        <svg class="chat-launcher-icon" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path fill="currentColor"
                  d="M12 3C6.5 3 2 6.9 2 11.7c0 2.7 1.4 5.1 3.6 6.7-.2 1.5-.9 2.9-2 3.9 1.8-.1 3.4-.8 4.6-1.7 1.1.3 2.4.5 3.8.5 5.5 0 10-3.9 10-8.7S17.5 3 12 3zm0 13.5c-1.2 0-2.4-.2-3.5-.5l-.7-.2-.6.4c-.6.4-1.4.8-2.2 1 .2-.7.4-1.4.6-2l.1-.5-.4-.3C3.6 13.4 2.9 11.6 2.9 9.7 2.9 6 6.9 3 12 3s9.1 3 9.1 6.7-4 6.8-9.1 6.8z"/>
        </svg>
        <span class="chat-launcher-close" aria-hidden="true">&times;</span>
    </button>
    <div class="chat-panel" id="chatPanel" role="dialog" aria-label="Shopping assistant" hidden>
        <div class="chat-header">
            <span class="chat-title">DhatchinaMart Assistant</span>
            <button type="button" class="chat-minimize" id="chatMinimize"
                    aria-label="Close the shopping assistant">&times;</button>
        </div>
        <div class="chat-messages" id="chatMessages" role="log" aria-live="polite">
            <div class="chat-msg chat-msg-bot">
                Hi! I can help you find products, manage your cart, check out, and track orders on DhatchinaMart.
            </div>
        </div>
        <form class="chat-form" id="chatForm">
            <input type="text" id="chatInput" class="chat-input"
                   placeholder="Ask about products, orders, cart..." maxlength="1000"
                   autocomplete="off" autofocus aria-label="Type your question"/>
            <button type="submit" class="chat-send" id="chatSend">Send</button>
        </form>
    </div>
</div>

<script src="${ctx}/js/chat.js"></script>
</body>
</html>
